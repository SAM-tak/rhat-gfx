import^gfx

# A triangle from a vertex buffer: position (vec2) and color (vec3) per vertex.
let^vs = "
    layout(location = 0) in vec2 a_pos;
    layout(location = 1) in vec3 a_color;
    layout(location = 0) out vec3 color;
    void main() {
        color = a_color;
        gl_Position = vec4(a_pos, 0.0, 1.0);
    }
    "
let^fs = "
    layout(location = 0) in vec3 color;
    layout(location = 0) out vec4 result;
    void main() { result = vec4(color, 1.0); }
    "

var^why = u8^[grow^]{}
let^ok = gfx.open("rhat-gfx buffer", 640, 360, 0)
if^!ok {
    gfx.error(ref^why)
    print^("open failed: ", string^(why[..]) catch^ "?")
    return^
}
var^pipeline = gfx.pipeline(vs, fs, gfx.CULL_NONE, gfx.BLEND_NONE, false^, false^)
let^vertices:f32^[15] = {
    0.0, 0.7, 1.0, 1.0, 0.0,
    -0.7, -0.7, 0.0, 1.0, 1.0,
    0.7, -0.7, 1.0, 0.0, 1.0
}
var^buffer = gfx.buffer(gfx.BUFFER_VERTEX, vertices.bytes)
if^pipeline.id = 0 or^buffer.id = 0 {
    gfx.error(ref^ why)
    print^("setup failed: ", string^(why[..]) catch^ "?")
    gfx.close()
    return^
}
var^frames:i64^= 0
repeat^while^gfx.frame() and^ frames < 30 {
    if^gfx.begin_screen(0.1, 0.1, 0.12, 1.0, false^) {
        pipeline.bind()
        buffer.bind()
        gfx.draw(3)
        gfx.end_pass()
    }
    frames := frames + 1
}
print^("frames ", frames, " saved ", gfx.screenshot("buffer.png"), " misuse ", gfx.misuse_count())
buffer.dispose()
pipeline.dispose()
gfx.close()
