import^gfx

let^ok = gfx.open("rhat-gfx clear", 640, 360, 0)
if^!ok {
    var^why:u8^[grow^] = {}
    gfx.error(ref^why)
    print^("open failed: ", string^(why[..]) catch^ "?")
    return^
}
var^frames:i64^ = 0
repeat^while^gfx.frame() and^ frames < 90 {
    let^t = f32^(frames) / 90.0
    if^gfx.begin_screen(t, 0.2, 1.0 - t, 1.0, false^) {
        gfx.end_pass()
    }
    frames := frames + 1
}
print^("frames ", frames, " saved ", gfx.screenshot("clear.png"), " misuse ", gfx.misuse_count())
gfx.close()
