module^audio

# PCM sound effects through SDL3's audio, independent of gfx and a window.
# Sounds are copied in as f32 samples in [-1, 1], mono or interleaved stereo;
# a voice is one playing instance of a sound.

externC^rg_audio_open:f^sample_rate:i64^ -> bool^;
externC^rg_audio_close:p^;
externC^rg_audio_create_sound:f^samples:f32^[:], count:i64^, sample_rate:i64^, channels:i64^ -> u64^;
externC^rg_audio_error:f^out:u8^[:], cap:i64^ -> i64^;
externC^rg_audio_release_sound:f^sound:u64^ -> bool^;
externC^rg_audio_play:f^sound:u64^, volume:f32^, pan:f32^, pitch:f32^, loop:bool^ -> u64^;
externC^rg_audio_playing:f^voice:u64^ -> bool^;
externC^rg_audio_stop:p^voice:u64^;
externC^rg_audio_stop_all:p^;

# A handle is 0 when nothing was made.
public^def^Sound { self^{ id:u64^ = 0 } }
public^def^Voice { self^{ id:u64^ = 0 } }

# Opens the default device; only one mixer may be open.
public^let^open = f^sample_rate:i64^ -> bool^ { return^ rg_audio_open(sample_rate) }
public^let^close = p^ { rg_audio_close() }

# Replaces text with why the last call failed.
public^let^error = p^text:ref^ grow^ u8^[] {
    text.clear()
    for^ 1 to^ 1024 { text.push(0) }
    let^ n = rg_audio_error(text[..], 1024)
    text.truncate(n)
}

public^let^sound = f^samples:f32^[:], sample_rate:i64^, channels:i64^ -> Sound {
    return^ Sound{id=rg_audio_create_sound(samples, samples.len, sample_rate, channels)}
}
public^let^release = p^s:Sound -> bool^ { return^ rg_audio_release_sound(s.id) }

# Volume from 0, pan from -1 (left) to 1 (right), pitch 1 for the recorded rate.
public^let^play = p^s:Sound, volume:f32^, pan:f32^, pitch:f32^, loop:bool^ -> Voice {
    return^ Voice{id=rg_audio_play(s.id, volume, pan, pitch, loop)}
}
public^let^playing = f^v:Voice -> bool^ { return^ rg_audio_playing(v.id) }
public^let^stop = p^v:Voice { rg_audio_stop(v.id) }
public^let^stop_all = p^ { rg_audio_stop_all() }
